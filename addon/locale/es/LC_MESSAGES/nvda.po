#. Translators: Announcement when reverse proxy connection test succeeds with latency in ms and provider name
#: addon\globalPlugins\visionAssistant\utils\media_capture.py:486
#, python-brace-format
msgid "Reverse proxy connected successfully to {provider}. Latency: {latency} ms"
msgstr "Proxy inverso conectado correctamente a {provider}. Latencia: {latency} ms"

#. Translators: Announcement when reverse proxy responds with an HTTP error status code
#: addon\globalPlugins\visionAssistant\utils\media_capture.py:495
#, python-brace-format
msgid "Reverse proxy reachable ({provider} returned HTTP {code}). Latency: {latency} ms"
msgstr "Proxy inverso accesible ({provider} devolvió HTTP {code}). Latencia: {latency} ms"

#. Translators: Announcement when proxy connection test fails with error details
#: addon\globalPlugins\visionAssistant\utils\media_capture.py:504
#: addon\globalPlugins\visionAssistant\utils\media_capture.py:544
#, python-brace-format
msgid "Proxy connection failed: {error}"
