#: addon\globalPlugins\visionAssistant\features\vision.py:322
#, python-brace-format
msgid "{name} - Direct Chat"
msgstr "{name} - Chat directo"

#. Translators: Dialog title for a Chat dialog
#: addon\globalPlugins\visionAssistant\features\vision.py:421
#, python-brace-format
