msgstr "&Aceptar"

#. Translators: Title of dialog asking the user to download the system audio (loopback) support library.
#: addon\globalPlugins\visionAssistant\utils\loopback.py:52
msgid "Download system audio support?"
msgstr "¿Descargar soporte de audio del sistema?"

#. Translators: Message in dialog asking the user to download the library used to capture the sound of the system speakers.
#: addon\globalPlugins\visionAssistant\utils\loopback.py:55
msgid "Capturing the system's sound requires an additional library (approximately 1MB download).\n\n"
"Download now to the addon's lib folder?\n\n"
"This is a one-time download."
msgstr "Capturar el sonido del sistema requiere una biblioteca adicional (descarga de aproximadamente 1 MB).\n\n"
"¿Descargarla ahora en la carpeta lib del complemento?\n\n"
"Esta es una descarga única."

#. Translators: Message reported when the user cancels downloading the system audio support library.
#: addon\globalPlugins\visionAssistant\utils\loopback.py:85
msgid "Operation cancelled. System audio capture is unavailable."
msgstr "Operación cancelada. La captura de audio del sistema no está disponible."

#. Translators: Spoken progress percentage during system audio loopback driver download. {percent} is the progress number.
#: addon\globalPlugins\visionAssistant\utils\loopback.py:108
#, python-brace-format
msgid "Downloading system audio support: {percent}%"
msgstr "Descargando soporte de audio del sistema: {percent}%"

#. Translators: Status message when downloading the system audio support library.
#: addon\globalPlugins\visionAssistant\utils\loopback.py:128
