msgstr "api etkinleştiriliyor"

#. Translators: Status message shown while creating a Gemini API key.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:713
msgid "Creating the API key..."
msgstr "API anahtarı oluşturuluyor..."

#. Translators: Name of the Google Cloud operation that creates an API key, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:734
msgid "API key creation"
msgstr "API anahtarı oluşturma"

#. Translators: Name of the Google Cloud operation that deletes an API key, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:749
msgid "API key deletion"
msgstr "API anahtarı silme"

#. Translators: Column header for API key value in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:796
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:806
msgid "Key"
msgstr "Anahtar"

#. Translators: Column header for project name in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:802
msgid "Project"
msgstr "Proje"

#. Translators: Column header for key label in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:804
msgid "Name"
msgstr "Ad"

#. Translators: Line appended to the conversation when the live session has ended.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:75
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:76
msgid "--- Session ended ---"
msgstr "--- Oturum sona erdi ---"

#. Translators: Message announced by NVDA when the live voice conversation ends.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:103
msgid "Live conversation ended."
msgstr "Canlı sohbeti sona erdi."

#. Translators: The webcam cannot be used while Live operator control is switched on.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:322
msgid "The webcam is not available while operator control is on."
msgstr "Operatör kontrolü açıkken web kamerası kullanılamaz."

#. Translators: The Live operator task was cancelled.
#. Translators: The user stopped the operation.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:258
#: addon\globalPlugins\visionAssistant\features\live_operator.py:676
msgid "Operator cancelled."
msgstr "İşlem iptal edildi."

#. Translators: The maximum duration of a Live operator task was reached.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:261
msgid "Operator time limit reached."
msgstr "Operatör zaman sınırı doldu."

#. Translators: The separate operator is already working.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:264
msgid "Standalone operator is busy."
msgstr "Bağımsız operatör meşgul."

#. Translators: A Live operator request or GUI operation took too long.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:275
msgid "Operator wait timed out."
msgstr "Operatör bekleme süresi doldu."

#. Translators: Computer control is blocked on a protected desktop.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:306
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:218
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:305
msgid "Secure mode, locked desktop or screen curtain is active."
msgstr "Güvenli mod, kilitli masaüstü veya ekran perdesi etkin durumda."

#. Translators: A usable screen image could not be captured.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:321
msgid "Invalid screenshot geometry or format."
msgstr "Ekran görüntüsünün geometrisi veya biçimi geçersiz."

#. Translators: The CAPTCHA answer returned by the AI did not contain usable characters.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:361
msgid "The CAPTCHA answer was empty."
msgstr "CAPTCHA yanıtı boştu."

#. Translators: The visual CAPTCHA was solved and its answer typed for the user.
#. Translators: The text CAPTCHA was solved and its answer typed for the user.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:392
#: addon\globalPlugins\visionAssistant\features\live_operator.py:414
#, python-brace-format
msgid "CAPTCHA solved and typed: {text}"
msgstr "CAPTCHA çözüldü ve girildi: {text}"

#. Translators: The visual CAPTCHA could not be solved automatically.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:394
msgid "The visual CAPTCHA could not be solved. Please complete it yourself."
msgstr "Görsel CAPTCHA çözülemedi. Lütfen kendiniz tamamlayın."

#. Translators: The AI service returned no usable CAPTCHA answer.
#. Translators: The service failed after its internal retry policy finished.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:406
#: addon\globalPlugins\visionAssistant\features\live_operator.py:569
msgid "The AI service returned no answer."
msgstr "YZ hizmeti herhangi bir yanıt vermedi."

#. Translators: No challenge was found on the current screen.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:410
msgid "No CAPTCHA was found on the screen."
msgstr "Ekranda CAPTCHA bulunamadı."

#. Translators: A visual challenge was found while the solver is switched off in settings.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:417
msgid "A visual CAPTCHA was found, but the solver is disabled in settings."
msgstr "Görsel bir CAPTCHA bulundu, ancak ayarlar bölümünden çözücü devre dışı bırakılmış."

#. Translators: The proposed click is outside the whole desktop area.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:512
msgid "Action is outside the screen."
msgstr "Eylem ekranın dışında gerçekleşiyor."

#. Translators: Reassurance spoken by Live when a step takes longer than usual.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:548
msgid "This is taking longer than usual. I am still working on it, please wait."
msgstr "Bu işlem normalden daha uzun sürüyor. Hala üzerinde çalışıyorum, lütfen bekleyin."

#. Translators: Message when the AI service stayed overloaded until the end.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:572
msgid "The AI service is busy and could not finish this task. Please try again in a moment."
msgstr "YZ hizmeti şu anda meşgul ve bu görevi tamamlayamadı. Lütfen bir süre sonra tekrar deneyin."

#. Translators: Invalid model output was rejected without moving the mouse or typing.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:579
msgid "The AI returned an invalid action. Nothing was executed."
msgstr "YZ geçersiz bir eylem döndürdü. Hiçbir işlem gerçekleştirilemedi."

#. Translators: Automatic retries are blocked after a site challenge.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:587
#: addon\globalPlugins\visionAssistant\features\live_operator.py:730
msgid "Complete the accessible challenge, toggle operator permission off and on, then ask to continue."
msgstr "Erişilebilirlik görevini tamamlayın, operatör iznini kapatıp açın, ardından devam etmek istediğinizi belirtin."

#. Translators: Unexpected failure of the Live operator.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:592
msgid "Operator failed. Check the add-on log for details."
msgstr "İşlem başarısız oldu. Ayrıntılar için eklenti günlüğünü kontrol edin."

#. Translators: Maximum number of approved steps reached.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:639
msgid "Ten-step limit reached; no further action executed."
msgstr "On adımlık sınır aşıldı; başka bir işlem gerçekleştirilemedi."

#. Translators: The operator proposed the same action again although nothing changed on screen.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:651
msgid "The same action was proposed again with no visible change, so the task stopped."
msgstr "Aynı işlem tekrar önerildi ancak gözle görülür bir değişiklik olmadı, bu nedenle görev durduruldu."

#. Translators: User-facing name for a successfully completed task.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:692
msgid "Completed"
msgstr "Tamamlandı"

#. Translators: User-facing name for a cancelled task.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:694
msgid "Cancelled"
msgstr "İptal edildi"

#. Translators: User-facing status when the user needs to take over.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:696
msgid "Your action is required"
msgstr "Harekete geçmeniz gerekiyor"

#. Translators: User-facing name for a task limit.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:698
msgid "Limit reached"
msgstr "Sınır aşıldı"

#. Translators: A Live operator result displayed in the conversation.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:704
#, python-brace-format
msgid "Live operator: {status}: {message}"
msgstr "Canlı operatör: {status}: {message}"

#. Translators: A tool call belongs to a conversation which has ended.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:721
msgid "Session is no longer active."
msgstr "Oturum artık aktif değil."

#. Translators: Computer control is disabled.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:724
msgid "Operator permission is not enabled for this session."
msgstr "Bu oturumda operatör izni etkinleştirilmemiş."

#. Translators: Another operator request is still running.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:727
msgid "Operator is busy."
msgstr "Operatör meşgul."

#. Translators: An invalid tool call has been rejected.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:736
msgid "Invalid tool or arguments."
msgstr "Geçersiz araç veya argümanlar."

#. Translators: Status message when UI Explorer starts
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:93
msgid "UI Explorer Active"
msgstr "Kullanıcı Arayüzü Gezgini Etkin"

#. Translators: Status message when UI Explorer stops
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:98
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:195
msgid "UI Explorer Stopped"
msgstr "Kullanıcı Arayüzü Gezgini Durduruldu"

#. Translators: Generic error message for AI failures
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:128
msgid "Unknown AI Error"
msgstr "Bilinmeyen Yapay Zeka Hatası"

#. Translators: Error shown when AI fails to find UI elements
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:164
msgid "AI failed to identify UI elements."
msgstr "Yapay zeka, kullanıcı arayüz öğelerini tanımlayamadı."

#. Translators: Announcement when the AI Operator is manually stopped
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:210
msgid "AI Operator stopped."
msgstr "YZ Operatörü durduruldu."

#. Translators: Prompt message asking what the AI Operator should do
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:227
msgid "What should I do or what is your question?"
msgstr "Ne yapmalıyım ya da sorunuz nedir?"

#. Translators: Message while processing request of the refine text command
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:245
#: addon\globalPlugins\visionAssistant\features\vision.py:587
msgid "Processing..."
msgstr "İşleniyor..."

#. Translators: Internal history label for user actions in operator sessions
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:384
msgid "Action performed. Checking result..."
msgstr "Eylem gerçekleştirildi. Sonuç kontrol ediliyor..."

#. Translators: The title of the interactive chat dialog for the AI Operator feature.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:470
#, python-brace-format
msgid "{name} - AI Operator"
msgstr "{name} - Yapay Zeka Operatörü"

#. Translators: Label for the user role in chat history
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:497
msgid "You"
msgstr "Sen"

#. Translators: Message spoken by NVDA when the current object already has a custom or AI-generated label. {name} is replaced with the existing label text.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:729
#, python-brace-format
msgid "Already labeled as: {name}"
msgstr "Zaten şu şekilde etiketlenmiş: {name}"

#. Translators: Progress message spoken when the add-on starts taking a screenshot of the current focused object.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:734
msgid "Identifying object..."
msgstr "Nesne tanımlanıyor..."

#. Translators: Success message spoken when the AI successfully assigns a new label to the object. {name} is replaced with the AI-generated label.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:767
#, python-brace-format
msgid "Labeled as: {name}"
msgstr "Şu şekilde etiketlendi: {name}"

#. Translators: Confirmation message shown after labels are deleted or renamed.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:818
msgid "Labels updated."
msgstr "Etiketler güncellendi."

#. Translators: Progress message spoken when the add-on begins scanning the current application window to find UI elements (like buttons or icons) that do not have accessibility names.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:839
msgid "Scanning application UI..."
msgstr "Uygulama kullanıcı arayüzü taranıyor..."

#. Translators: Message spoken when the add-on finishes the UI scan but finds no unnamed elements to label (everything already has a name).
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:882
msgid "No unnamed elements found."
msgstr "Adlandırılmamış öğe bulunamadı."

#. Translators: Progress message spoken when the add-on has found unnamed elements and is now sending the full application screenshot to AI for batch labeling.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:886
msgid "Analyzing application..."
msgstr "Uygulama analiz ediliyor..."

#. Translators: Success message spoken when the AI finishes analyzing the app and successfully names multiple elements in the background.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:971
msgid "Application labeling complete."
msgstr "Uygulama etiketleme tamamlandı."

#. Translators: Error message spoken when the add-on fails to parse or map the labels returned by the AI (e.g., due to invalid AI response format).
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:977
msgid "Batch labeling failed."
msgstr "Toplu etiketleme başarısız."

#. Translators: Announcement when the visual CAPTCHA solver is manually aborted
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1002
msgid "Visual CAPTCHA solver aborted."
msgstr "Görsel CAPTCHA çözücüsü iptal edildi."

#. Translators: Message reported by NVDA when the user triggers the CAPTCHA solving command.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1022
msgid "Solving..."
msgstr "Çözülüyor..."

#. Translators: Message reported when image capture fails during CAPTCHA solve.
#. Translators: Status message reported when screen or window capture fails
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1033
#: addon\globalPlugins\visionAssistant\features\vision.py:1503
msgid "Capture failed."
msgstr "Yakalama başarısız."

#. Translators: Message reported when a visual CAPTCHA is successfully solved.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1042
msgid "Visual CAPTCHA solved!"
msgstr "Görsel CAPTCHA çözüldü!"

#. Translators: Message reported by NVDA when the AI cannot detect any CAPTCHA in the captured image.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1066
msgid "No CAPTCHA detected."
msgstr "CAPTCHA algılanmadı."

#. Translators: Message reported when a visual CAPTCHA (like reCAPTCHA) is detected.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1074
msgid "Visual CAPTCHA detected. Entering solving mode... This may take a little while."
msgstr "Görsel CAPTCHA algılandı. Çözüm moduna giriliyor... Bu işlem biraz zaman alabilir."

#. Translators: Message reported when a visual CAPTCHA is detected but the solver is disabled.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1085
msgid "Visual CAPTCHA detected, but the solver is disabled in settings."
msgstr "Görsel CAPTCHA algılandı ancak çözücü ayarlarda devre dışı bırakıldı."

#. Translators: Message reported when image capture fails or AI returns empty.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1091
msgid "Capture failed or AI returned empty response."
msgstr "Yakalama başarısız oldu veya yapay zeka boş yanıt verdi."

#. Translators: Message reported by NVDA after successfully solving a text CAPTCHA, announcing the characters found.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1113
#, python-brace-format
msgid "Captcha: {text}"
msgstr "Captcha: {text}"

#. Translators: Message reported when AI fails to solve the visual CAPTCHA after max attempts.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1237
msgid "Failed to solve CAPTCHA after maximum attempts."
msgstr "Maksimum deneme sayısına ulaşıldıktan sonra CAPTCHA çözülemedi."

#. Translators: Value representing the ON state for a toggle setting (e.g., in quick settings).
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:122
msgid "On"
msgstr "Aç"

#. Translators: Value representing the OFF state for a toggle setting (e.g., in quick settings).
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:124
msgid "Off"
msgstr "Kapalı"

#. Translators: Value announced in quick settings when the setting has no value selected yet.
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:137
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:147
msgid "Default"
msgstr "Varsayılan"

#. Translators: Announced when navigating to AI Model quick settings
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:152
#, python-brace-format
msgid "{setting}, Current: {val}. Use left and right arrows to change."
msgstr "{setting}, Geçerli: {val}. Değiştirmek için sol ve sağ ok tuşlarını kullanın."

#. Translators: Warning when models list is not fetched
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:243
#, python-brace-format
msgid "No models fetched for {provider}. Please update models list from settings."
msgstr "{provider} için model alınmadı. Lütfen model listesini ayarlardan güncelleyin."

#. Translators: Message of a dialog which may pop up while performing an AI call
#: addon\globalPlugins\visionAssistant\features\upload.py:89
#, python-brace-format
msgid "File Upload Error: {error}"
msgstr "Dosya Yükleme Hatası: {error}"

#. Translators: Prompt asking the user to manually input YouTube video duration.
#: addon\globalPlugins\visionAssistant\features\video.py:130
msgid "Please enter the YouTube video duration in minutes (e.g., 10 or 10.5).\n"
"If you enter an incorrect duration, the audio description may not be complete."
msgstr "Lütfen YouTube video süresini dakika cinsinden girin (ör. 10 veya 10,5).\n"
"Yanlış bir süre girerseniz sesli betimleme tamamlanamayabilir."

#. Translators: Title for the YouTube duration input dialog.
#: addon\globalPlugins\visionAssistant\features\video.py:133
msgid "YouTube Video Duration"
msgstr "YouTube Video Süresi"

#. Translators: Error message shown when the entered YouTube duration is invalid.
#: addon\globalPlugins\visionAssistant\features\video.py:156
msgid "Invalid duration entered. Video analysis cancelled."
msgstr "Geçersiz süre girildi. Video analizi iptal edildi."

#. Translators: Title of the video action selection dialog.
#: addon\globalPlugins\visionAssistant\features\video.py:173
msgid "Video Action"
msgstr "Video Eylemi"

#. Translators: Error message when video analysis is attempted with a non-Gemini provider.
#: addon\globalPlugins\visionAssistant\features\video.py:282
msgid "Video analysis is only supported by Gemini providers."
msgstr "Video analizi yalnızca Gemini sağlayıcıları tarafından desteklenir."

#. Translators: Error message when the provided video URL is not valid.
#: addon\globalPlugins\visionAssistant\features\video.py:534
msgid "Error: Invalid URL."
msgstr "Hata: Geçersiz Bağlantı."

#. Translators: Error message when the video URL is from an unsupported website.
#: addon\globalPlugins\visionAssistant\features\video.py:547
msgid "Error: Unsupported platform. Only YouTube, Instagram, Twitter, and TikTok are supported."
msgstr "Hata: Desteklenmeyen platform. Yalnızca YouTube, Instagram, Twitter ve TikTok desteklenmektedir."

#. Translators: Disclaimer added at the beginning of AI-generated SRT files.
#: addon\globalPlugins\visionAssistant\features\video.py:628
msgid "Disclaimer: This audio description was generated by AI. Some details, including character identities or events, may not be entirely accurate."
msgstr "Sorumluluk Reddi: Bu sesli betimleme yapay zeka tarafından üretilmiştir. Karakter kimlikleri veya olaylar dahil olmak üzere bazı ayrıntılar tamamen doğru olmayabilir."

#. Translators: Status message when uploading the video to the AI service fails. {error} holds the service-provided message.
#: addon\globalPlugins\visionAssistant\features\video.py:784
#, python-brace-format
msgid "Video upload failed: {error}"
msgstr "Video yükleme başarısız: {error}"

#. Translators: Status message when the AI is analyzing the whole video to extract character names and appearances.
#: addon\globalPlugins\visionAssistant\features\video.py:811
msgid "Extracting characters (First pass)..."
msgstr "Karakterler ayıklanıyor (İlk geçiş)..."

#. Translators: Error message shown when the AI fails to extract character information from the video.
#: addon\globalPlugins\visionAssistant\features\video.py:862
#: addon\globalPlugins\visionAssistant\features\video.py:943
msgid "Character extraction failed."
msgstr "Karakter çıkarılamadı."

#. Translators: Status message when re-uploading the video after clearing its cache fails. {error} holds the service-provided message.
#: addon\globalPlugins\visionAssistant\features\video.py:910
#, python-brace-format
msgid "Video upload failed after cache retry: {error}"
msgstr "Önbellek yeniden denemesinden sonra video yüklenemedi: {error}"

#. Translators: Header for the list of extracted characters in the generated subtitle.
#: addon\globalPlugins\visionAssistant\features\video.py:1035
msgid "GLOBAL CHARACTER DICTIONARY:"
msgstr "KÜRESEL KARAKTER SÖZLÜĞÜ:"

#. Translators: Status message shown when the add-on pauses briefly between API requests to prevent hitting server rate limits. {seconds} is the number of seconds.
#: addon\globalPlugins\visionAssistant\features\video.py:1058
#, python-brace-format
msgid "Cooling down to prevent rate limits ({seconds} seconds)..."
msgstr "İstek sınırlarını önlemek için bekleniyor ({seconds} saniye)..."

#. Translators: Header for the list of characters introduced up to the current video scene.
#: addon\globalPlugins\visionAssistant\features\video.py:1114
msgid "GLOBAL CHARACTER DICTIONARY (Active characters in this scene):"
msgstr "GLOBAL KARAKTER SÖZLÜĞÜ (Bu sahnedeki aktif karakterler):"

#. Translators: Status message reporting which segment of the video is currently being analyzed. {current} is the current segment number and {total} is the total segment count.
#: addon\globalPlugins\visionAssistant\features\video.py:1145
#, python-brace-format
msgid "Analyzing video segment {current} of {total}..."
msgstr "Video bölümü analiz ediliyor: {current} / {total}..."

#. Translators: Message reported when AI is analyzing the video
#: addon\globalPlugins\visionAssistant\features\video.py:1151
#: addon\globalPlugins\visionAssistant\features\video.py:1512
msgid "Analyzing video..."
msgstr "Video analiz ediliyor..."

#. Translators: Error message reported when video segment analysis fails after multiple retries due to network issues.
#: addon\globalPlugins\visionAssistant\features\video.py:1181
#: addon\globalPlugins\visionAssistant\features\video.py:1295
msgid "Connection failed after retries."
msgstr "Yeniden denemelerden sonra bağlantı başarısız oldu."

#. Translators: Status message shown when a video segment finishes processing and the system is moving to the next one. {current} is the completed segment number.
#: addon\globalPlugins\visionAssistant\features\video.py:1248
#, python-brace-format
msgid "Segment {current} finished. Preparing next..."
msgstr "Bölüm {current} tamamlandı. Sonraki hazırlanıyor..."

#. Translators: Status message when all segments are done and it is finalizing.
#: addon\globalPlugins\visionAssistant\features\video.py:1251
msgid "Finalizing..."
msgstr "Sonlandırılıyor..."

#. Translators: Error message shown when the AI output cannot be converted into a valid SRT subtitle file.
#: addon\globalPlugins\visionAssistant\features\video.py:1279
msgid "Failed to parse AI output into SRT."
msgstr "Yapay zeka çıktısı SRT formatına ayrıştırılamadı."

#. Translators: Error message when video recording is attempted with a non-Gemini provider
#: addon\globalPlugins\visionAssistant\features\video.py:1329
msgid "Video recording is only supported by Gemini providers."
msgstr "Video kaydı yalnızca Gemini sağlayıcıları tarafından desteklenir."

#. Translators: Status message reported when starting video recording
#: addon\globalPlugins\visionAssistant\features\video.py:1344
msgid "Starting recording..."
msgstr "Kayıt başlatılıyor..."

#. Translators: Message when window capture fails and switches to full screen capture
#: addon\globalPlugins\visionAssistant\features\video.py:1416
msgid "Window capture failed. Trying full screen..."
msgstr "Pencere yakalama başarısız oldu. Tam ekran deneniyor..."

