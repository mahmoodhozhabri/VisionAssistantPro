#. Translators: Option to use the global feedback setting for a custom prompt.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:227
msgid "Use global setting (default)"
msgstr "Використовувати глобальні налаштування (початково)"

#. Translators: Option to copy prompt result to clipboard.
#. Translators: Checkbox to enable copying AI responses to clipboard
#: addon\globalPlugins\visionAssistant\prompt_utils.py:229
#: addon\globalPlugins\visionAssistant\dialogs\settings.py:356
msgid "Copy AI responses to clipboard"
msgstr "Копіювати відповіді ШІ в буфер обміну"

#. Translators: Option to output prompt result directly without opening a chat window.
#. Translators: Checkbox to skip chat window and only speak AI responses
#: addon\globalPlugins\visionAssistant\prompt_utils.py:231
#: addon\globalPlugins\visionAssistant\dialogs\settings.py:366
msgid "Direct Output (No Chat Window)"
msgstr "Прямий вивід (без вікна чату)"

#. Translators: Option to copy prompt result to clipboard and output directly without a chat window.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:233
msgid "Copy AI responses to clipboard and Direct Output"
msgstr "Копіювання відповідей ШІ в буфер обміну та прямий вивід"

#. Translators: Option to display prompt results in a chat window with follow-up questions.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:235
msgid "Chat Window (Ask questions)"
msgstr "Діалог чату (Задати питання)"

#. Translators: Validation error for empty prompt text.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:458
#: addon\globalPlugins\visionAssistant\prompt_utils.py:462
#: addon\globalPlugins\visionAssistant\dialogs\prompt_manager_dialog.py:136
#: addon\globalPlugins\visionAssistant\dialogs\prompt_manager_dialog.py:578
msgid "Prompt text cannot be empty."
msgstr "Текст підказки не може бути порожнім."

#. Translators: Validation error when multiple ambient observer modes are used in a single prompt.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:467
#, python-brace-format
msgid ""
"Cannot combine multiple ambient observer modes ({modes}) in the same prompt."
msgstr ""
"Неможливо поєднати кілька режимів спостерігача ({modes}) в одному запиті."

#. Translators: Validation error when static capture variables are combined with an ambient observer mode.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:475
#, python-brace-format
msgid ""
"Cannot combine static capture variables ({vars}) with ambient observer "
"({mode})."
msgstr ""
"Неможливо поєднати статичні змінні захоплення ({vars}) із змінними "
"спостерігача ({mode})."

#. Translators: Validation error when both loopback and mic audio sources are specified.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:482
msgid "Cannot combine both [loopback] and [mic] audio sources."
msgstr "Неможливо поєднати джерела звуку [loopback] та [microphone]."

#. Translators: Validation error when [loopback] is used without [ambient_audio].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:486
msgid "[loopback] can only be used with [ambient_audio]."
msgstr "[loopback] можна використовувати лише з [ambient_audio]."

#. Translators: Validation error when [mic] is used without [ambient_audio] or [ambient_webcam].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:490
msgid "[mic] can only be used with [ambient_audio] or [ambient_webcam]."
msgstr ""
"[mic] можна використовувати лише з [ambient_audio] або [ambient_webcam]."

#. Translators: Validation error when both brief and detailed reporting styles are specified.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:496
msgid "Cannot combine both [brief] and [detailed] reporting styles."
msgstr "Не можна поєднувати стилі звітності [brief] та [detailed]."

#. Translators: Validation error when reporting styles are used with [ambient_audio].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:501
msgid ""
"Reporting styles ([brief], [detailed]) cannot be used with [ambient_audio]."
msgstr ""
"Стилі звітності ([brief], [detailed]) не можна використовувати з "
"[ambient_audio]."

#. Translators: Validation error when reporting styles are used without an ambient visual observer.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:504
msgid ""
"Reporting styles ([brief], [detailed]) can only be used with [ambient_screen] "
"or [ambient_webcam]."
msgstr ""
"Стилі звітності ([brief], [detailed]) можна використовувати лише з "
"[ambient_screen] або [ambient_webcam]."

#. Translators: Validation error when a [lang:code] tag is malformed.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:510
#, python-brace-format
msgid ""
"Invalid language tag '{tag}'. Use [lang:code], for example [lang:fa] or "
"[lang:en]."
msgstr ""
"Недійсний мовний тег \"{tag}\". Використовуйте [lang:code], наприклад "
"[lang:fa] або [lang:en]."

#. Translators: Validation error when multiple [lang:code] tags are present in the same prompt.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:514
msgid "Only one [lang:code] tag can be used in a prompt."
msgstr "У запиті можна використовувати лише один тег [lang:code]."

#. Translators: Validation error when [lang:code] is used without an ambient mode.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:518
msgid "[lang:code] can only be used with ambient observer modes."
msgstr "[lang:code] можна використовувати лише з режимами спостерігача."

#. Translators: Validation error when non-variable text instructions are included in [ambient_audio].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:528
msgid ""
"Audio Observer does not accept instructional text prompts. Only audio source "
"and [lang:code] are supported."
msgstr ""
"Спостерігач аудіо не приймає текстові підказки з інструкціями. Підтримуються "
"лише джерело аудіо та [lang:code]."

