msgstr "Аналіз..."

#. Translators: Status message when extracting audio and connecting to Gemini for dubbing
#: addon\globalPlugins\visionAssistant\features\audio.py:343
msgid "Extracting audio and connecting to Gemini..."
msgstr "Видобування аудіо та підключення до Gemini..."

#. Translators: Error message shown when Live Translate cannot connect to the server.
#: addon\globalPlugins\visionAssistant\features\audio.py:474
msgid "WebSocket connection failed for all available API keys."
msgstr "Помилка підключення через WebSocket для всіх доступних ключів API."

#. Translators: Error message shown when the Live translation setup fails.
#: addon\globalPlugins\visionAssistant\features\audio.py:507
#, python-brace-format
msgid "Failed to setup Live translation session. Error: {error}"
msgstr "Не вдалося налаштувати сеанс Live перекладу. Помилка: {error}"

#. Translators: Status message part showing estimated time remaining and completion time.
#: addon\globalPlugins\visionAssistant\features\audio.py:525
#, python-brace-format
msgid " (approx. {mins} min {secs} sec, finishing around {time})"
msgstr " (приблизно {mins} хв {secs} сек, завершення приблизно {time})"

#. Translators: Status message part showing estimated seconds remaining and completion time.
#: addon\globalPlugins\visionAssistant\features\audio.py:530
#, python-brace-format
msgid " (approx. {secs} sec, finishing around {time})"
msgstr " (приблизно {secs} сек, завершення приблизно {time})"

#. Translators: Status message when live dubbing is actively streaming
#: addon\globalPlugins\visionAssistant\features\audio.py:535
msgid "Dubbing in progress..."
msgstr "Триває дублювання..."

#. Translators: Error message shown when live dubbing fails to return any audio
#: addon\globalPlugins\visionAssistant\features\audio.py:647
msgid "Dubbing failed. No audio returned. Check NVDA log for details."
msgstr ""
"Дублювання не вдалося. Аудіодані не отримано. Детальнішу інформацію дивіться "
"у журналі NVDA."

#. Translators: Dialog title when saving a dubbed media file
#: addon\globalPlugins\visionAssistant\features\audio.py:710
msgid "Save dubbed audio as"
msgstr "Зберегти дубльований аудіо як"

#. Translators: Message reported when dubbed file is successfully saved
#: addon\globalPlugins\visionAssistant\features\audio.py:726
#, python-brace-format
msgid "Dubbed file saved: {path}"
msgstr "Дубльований файл збережено: {path}"

#. Translators: Status message when dubbing process finishes
#: addon\globalPlugins\visionAssistant\features\audio.py:736
msgid "Dubbing finished."
msgstr "Дублювання завершено."

#. Translators: Error message when live translate fails
#: addon\globalPlugins\visionAssistant\features\audio.py:742
msgid "Dubbing failed."
msgstr "Дублювання не вдалося."

#. Translators: Error message shown when a Google API call fails, {status} is the HTTP status code and {detail} is Google's own message.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:107
#, python-brace-format
msgid "Google API error (HTTP {status}): {detail}"
msgstr "Помилка API Google (HTTP {status}): {detail}"

#. Translators: Error message shown when the user cancels a running Gemini key operation.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:144
msgid "Operation cancelled."
msgstr "Операцію скасовано."

#. Translators: Error message shown when a Google Cloud operation takes too long, {operation} describes the operation.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:154
#, python-brace-format
msgid "Timed out while waiting for {operation}."
msgstr "Час очікування  минув {operation}."

#. Translators: Error message shown when saved credentials lack Google Cloud permission.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:258
msgid ""
"Google Cloud permission was not granted. Please click Sign In again and check "
"the Google Cloud checkbox."
msgstr ""
"Дозвіл на доступ до Google Cloud не надано. Будь ласка, натисніть «Увійти» ще "
"раз і поставте прапорець біля Google Cloud."

#. Translators: Error message shown when the user is not signed in to Google Cloud.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:280
msgid "You are not signed in to Google Cloud. Use the Sign In button first."
msgstr "Ви не ввійшли в Google Cloud. Спочатку скористайтеся кнопкою «Увійти»."

#. Translators: Title and heading of the web page shown in the browser after successful Google sign-in.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:324
msgid "Authentication Successful"
msgstr "Автентифікація успішна"

#. Translators: Message shown in the browser after successful Google sign-in.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:326
msgid ""
"Authentication successful! You can now close this browser tab and return to "
"NVDA."
msgstr ""
"Автентифікація успішна! Тепер ви можете закрити цю вкладку браузера та "
"повернутися до NVDA."

#. Translators: Title and heading of the web page shown in the browser when Google sign-in fails.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:338
msgid "Sign-in Failed"
msgstr "Не вдалося увійти"

#. Translators: Status message shown when the Google sign-in process starts and a browser window will open.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:350
msgid "Starting Google sign-in. A browser window will open."
msgstr "Початок входу в Google. Відкриється вікно браузера."

#. Translators: Status message shown when the add-on opens the browser for Google sign-in.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:383
msgid ""
"Opening the browser for sign-in... Please check the Google Cloud permission "
"box."
msgstr ""
"Відкриття браузера для входу... Будь ласка, поставте прапорець біля дозволу "
"Google Cloud."

#. Translators: Error message shown when Google sign-in times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:392
msgid "Google sign-in timed out."
msgstr "Час очікування входу в Google минув."

#. Translators: Error message shown when Google sign-in returns an error, {error} is the error code.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:402
#, python-brace-format
msgid "Google sign-in failed: {error}"
msgstr "Не вдалося ввійти в Google: {error}"

#. Translators: Error message shown when Google sign-in fails due to OAuth state mismatch.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:405
msgid "Google sign-in failed: state mismatch."
msgstr "Помилка під час входу через Google: невідповідність стану."

#. Translators: Error message shown when Google sign-in was not completed or no auth code was returned.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:408
msgid "Google sign-in did not complete."
msgstr "Вхід у Google не завершено."

#. Translators: Status message shown when exchanging the authorization code for tokens.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:411
msgid "Exchanging authorization code..."
msgstr "Обмін кодом авторизації..."

#. Translators: Error message shown when Google returns no access token during authentication.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:447
msgid "No access token returned by Google."
msgstr "Google не повернув токен доступу."

#. Translators: Error message shown when Google Cloud permission was not consented on Google sign-in.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:453
msgid ""
"Google Cloud permission was not granted. Please sign in again and ensure the "
"Google Cloud checkbox is ticked on the Google consent page."
msgstr ""
"Дозвіл на доступ до Google Cloud не надано. Будь ласка, увійдіть ще раз і "
"переконайтеся, що на сторінці згоди Google встановлено прапорець Google Cloud."

#. Translators: Status message shown when the Google sign-in completed successfully.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:475
msgid "Signed in successfully."
msgstr "Вхід виконано."

#. Translators: Status message shown when the stored Google credentials are removed.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:481
msgid "Removing the stored Google credentials..."
msgstr "Видалення збережених облікових даних Google..."

#. Translators: Status message shown when signed out successfully.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:517
msgid "Signed out successfully."
msgstr "Вихід виконано."

#. Translators: Status message shown while creating a Google Cloud project.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:641
msgid "Creating the project..."
msgstr "Створення проєкту..."

#. Translators: Name of the Google Cloud operation that creates a project, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:653
msgid "project creation"
msgstr "створення проєкту"

#. Translators: Status message shown while enabling a Google API on a project.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:661
msgid "Enabling an API..."
msgstr "Увімкнення API..."

#. Translators: Status message shown while retrying to enable a Google API, {seconds} is the delay in seconds.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:666
#, python-brace-format
msgid "Retrying in {seconds} seconds..."
msgstr "Повторна спроба через {seconds} секунд..."

#. Translators: Name of the Google Cloud operation that enables an API, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:684
msgid "enabling the API"
msgstr "увімкнення API"

#. Translators: Status message shown while creating a Gemini API key.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:713
msgid "Creating the API key..."
msgstr "Створення ключа API..."

#. Translators: Name of the Google Cloud operation that creates an API key, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:734
msgid "API key creation"
msgstr "Створення API-ключа"

#. Translators: Name of the Google Cloud operation that deletes an API key, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:749
msgid "API key deletion"
msgstr "Видалення ключа API"

#. Translators: Column header for API key value in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:796
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:806
msgid "Key"
msgstr "Ключ"

#. Translators: Column header for project name in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:802
msgid "Project"
msgstr "Проєкт"

#. Translators: Column header for key label in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:804
msgid "Name"
msgstr "Назва"

#. Translators: Line appended to the conversation when the live session has ended.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:75
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:76
msgid "--- Session ended ---"
msgstr "--- Сеанс закінчено ---"

#. Translators: Message announced by NVDA when the live voice conversation ends.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:103
msgid "Live conversation ended."
msgstr "Live чат завершено."

#. Translators: The webcam cannot be used while Live operator control is switched on.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:322
msgid "The webcam is not available while operator control is on."
msgstr "Веб-камера недоступна, коли ввімкнено керування оператором ШІ."

#. Translators: The Live operator task was cancelled.
#. Translators: The user stopped the operation.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:258
#: addon\globalPlugins\visionAssistant\features\live_operator.py:676
msgid "Operator cancelled."
msgstr "Виконання скасовано."

#. Translators: The maximum duration of a Live operator task was reached.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:261
msgid "Operator time limit reached."
msgstr "Досягнуто ліміту часу оператора."

#. Translators: The separate operator is already working.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:264
msgid "Standalone operator is busy."
msgstr "Оператор зайнятий."

#. Translators: A Live operator request or GUI operation took too long.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:275
msgid "Operator wait timed out."
msgstr "Час очікування оператора вичерпано."

#. Translators: Computer control is blocked on a protected desktop.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:306
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:215
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:297
msgid "Secure mode, locked desktop or screen curtain is active."
msgstr "Увімкнено безпечний режим, захищений робочий стіл або екранну завісу."

#. Translators: A usable screen image could not be captured.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:321
msgid "Invalid screenshot geometry or format."
msgstr "Неправильна геометрія або формат знімка екрана."

#. Translators: The CAPTCHA answer returned by the AI did not contain usable characters.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:361
msgid "The CAPTCHA answer was empty."
msgstr "Відповідь CAPTCHA була порожньою."

#. Translators: The visual CAPTCHA was solved and its answer typed for the user.
#. Translators: The text CAPTCHA was solved and its answer typed for the user.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:392
#: addon\globalPlugins\visionAssistant\features\live_operator.py:414
#, python-brace-format
msgid "CAPTCHA solved and typed: {text}"
msgstr "CAPTCHA розгадана та введена: {text}"

#. Translators: The visual CAPTCHA could not be solved automatically.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:394
msgid "The visual CAPTCHA could not be solved. Please complete it yourself."
msgstr ""
"Не вдалося розгадати візуальну капчу. Будь ласка, введіть відповідь "
"самостійно."

#. Translators: The AI service returned no usable CAPTCHA answer.
#. Translators: The service failed after its internal retry policy finished.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:406
#: addon\globalPlugins\visionAssistant\features\live_operator.py:569
msgid "The AI service returned no answer."
msgstr "Сервіс ШІ не надав жодної відповіді."

#. Translators: No challenge was found on the current screen.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:410
msgid "No CAPTCHA was found on the screen."
msgstr "CAPTCHA на екрані не знайдено."

#. Translators: A visual challenge was found while the solver is switched off in settings.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:417
msgid "A visual CAPTCHA was found, but the solver is disabled in settings."
msgstr "Візуальну капчу знайдено, але розв'язувач вимкнено в налаштуваннях."

#. Translators: The proposed click is outside the whole desktop area.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:512
msgid "Action is outside the screen."
msgstr "Дія відбувається поза екраном."

#. Translators: Reassurance spoken by Live when a step takes longer than usual.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:548
msgid "This is taking longer than usual. I am still working on it, please wait."
msgstr ""
"Це займає більше часу, ніж зазвичай. Я все ще над цим працюю, будь ласка, "
"зачекайте."

#. Translators: Message when the AI service stayed overloaded until the end.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:572
msgid ""
"The AI service is busy and could not finish this task. Please try again in a "
"moment."
msgstr ""
"Сервіс ШІ зараз зайнятий і не зміг виконати це завдання. Будь ласка, "
"спробуйте ще раз через деякий час."

#. Translators: Invalid model output was rejected without moving the mouse or typing.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:579
msgid "The AI returned an invalid action. Nothing was executed."
msgstr "ШІ повернув недійсну дію. Нічого не було виконано."

#. Translators: Automatic retries are blocked after a site challenge.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:587
#: addon\globalPlugins\visionAssistant\features\live_operator.py:730
msgid ""
"Complete the accessible challenge, toggle operator permission off and on, "
"then ask to continue."
msgstr ""
"Виконайте завдання щодо доступності, увімкніть та вимкніть дозвіл оператора, "
"а потім попросіть продовжити."

#. Translators: Unexpected failure of the Live operator.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:592
msgid "Operator failed. Check the add-on log for details."
msgstr ""
"Помилка оператора. Перегляньте журнал додатка для отримання детальної "
"інформації."

#. Translators: Maximum number of approved steps reached.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:639
msgid "Ten-step limit reached; no further action executed."
msgstr "Досягнуто ліміту в десять кроків; подальші дії не виконано."

#. Translators: The operator proposed the same action again although nothing changed on screen.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:651
msgid ""
"The same action was proposed again with no visible change, so the task "
"stopped."
msgstr ""
"Ця сама дія була запропонована знову без видимих змін, тому виконання "
"завдання було припинено."

#. Translators: User-facing name for a successfully completed task.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:692
msgid "Completed"
msgstr "Завершено"

#. Translators: User-facing name for a cancelled task.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:694
msgid "Cancelled"
msgstr "Скасовано"

#. Translators: User-facing status when the user needs to take over.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:696
msgid "Your action is required"
msgstr "Необхідна ваша дія"

#. Translators: User-facing name for a task limit.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:698
msgid "Limit reached"
msgstr "Досягнуто ліміту"

#. Translators: A Live operator result displayed in the conversation.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:704
#, python-brace-format
msgid "Live operator: {status}: {message}"
msgstr "Live оператор: {status}: {message}"

#. Translators: A tool call belongs to a conversation which has ended.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:721
msgid "Session is no longer active."
msgstr "Сеанс більше не активний."

#. Translators: Computer control is disabled.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:724
msgid "Operator permission is not enabled for this session."
msgstr "Для цього сеансу не ввімкнено дозвіл оператора."

#. Translators: Another operator request is still running.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:727
msgid "Operator is busy."
msgstr "Оператор зайнятий."

#. Translators: An invalid tool call has been rejected.
#: addon\globalPlugins\visionAssistant\features\live_operator.py:736
msgid "Invalid tool or arguments."
msgstr "Недійсний інструмент або аргументи."

#. Translators: Status message when UI Explorer starts
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:93
msgid "UI Explorer Active"
msgstr "Досліджувач інтерфейсу користувача активовано"

#. Translators: Status message when UI Explorer stops
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:98
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:192
msgid "UI Explorer Stopped"
msgstr "Досліджувач інтерфейсу користувача зупинено"

#. Translators: Generic error message for AI failures
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:125
msgid "Unknown AI Error"
msgstr "Невідома помилка ШІ"

#. Translators: Error shown when AI fails to find UI elements
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:161
msgid "AI failed to identify UI elements."
msgstr "ШІ не вдалося ідентифікувати елементи інтерфейсу користувача."

#. Translators: Announcement when the AI Operator is manually stopped
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:207
msgid "AI Operator stopped."
msgstr "Оператора ШІ зупинено."

#. Translators: Prompt message asking what the AI Operator should do
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:224
msgid "What should I do or what is your question?"
msgstr "Що мені зробити, або яке у вас питання?"

#. Translators: Message while processing request of the refine text command
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:240
#: addon\globalPlugins\visionAssistant\features\vision.py:571
msgid "Processing..."
msgstr "Обробка..."

#. Translators: Internal history label for user actions in operator sessions
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:375
msgid "Action performed. Checking result..."
msgstr "Дія виконана. Перевірка результату..."

#. Translators: The title of the interactive chat dialog for the AI Operator feature.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:459
#, python-brace-format
msgid "{name} - AI Operator"
msgstr "{name} - ШІ оператор"

#. Translators: Label for the user role in chat history
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:486
msgid "You"
msgstr "Ви"

#. Translators: Message spoken by NVDA when the current object already has a custom or AI-generated label. {name} is replaced with the existing label text.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:718
#, python-brace-format
msgid "Already labeled as: {name}"
msgstr "Вже підписано як: {name}"

#. Translators: Progress message spoken when the add-on starts taking a screenshot of the current focused object.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:723
msgid "Identifying object..."
msgstr "Ідентифікація об'єкта..."

#. Translators: Success message spoken when the AI successfully assigns a new label to the object. {name} is replaced with the AI-generated label.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:755
#, python-brace-format
msgid "Labeled as: {name}"
msgstr "Підписано як: {name}Файл: {name}"

#. Translators: Confirmation message shown after labels are deleted or renamed.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:806
msgid "Labels updated."
msgstr "Підписи оновлено."

#. Translators: Progress message spoken when the add-on begins scanning the current application window to find UI elements (like buttons or icons) that do not have accessibility names.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:827
msgid "Scanning application UI..."
msgstr "Сканування інтерфейсу програми..."

#. Translators: Message spoken when the add-on finishes the UI scan but finds no unnamed elements to label (everything already has a name).
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:870
msgid "No unnamed elements found."
msgstr "Елементів без підпису не знайдено."

#. Translators: Progress message spoken when the add-on has found unnamed elements and is now sending the full application screenshot to AI for batch labeling.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:874
msgid "Analyzing application..."
msgstr "Аналіз програми..."

#. Translators: Success message spoken when the AI finishes analyzing the app and successfully names multiple elements in the background.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:956
msgid "Application labeling complete."
msgstr "Підпис елементів програми завершено."

#. Translators: Error message spoken when the add-on fails to parse or map the labels returned by the AI (e.g., due to invalid AI response format).
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:962
msgid "Batch labeling failed."
msgstr "Помилка пакетного підпису."

#. Translators: Announcement when the visual CAPTCHA solver is manually aborted
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:986
msgid "Visual CAPTCHA solver aborted."
msgstr "Розв'язувач візуальної КАПЧІ перервано."

#. Translators: Message reported by NVDA when the user triggers the CAPTCHA solving command.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1006
msgid "Solving..."
msgstr "Вирішення..."

#. Translators: Message reported when image capture fails during CAPTCHA solve.
#. Translators: Status message reported when screen or window capture fails
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1015
#: addon\globalPlugins\visionAssistant\features\vision.py:1472
msgid "Capture failed."
msgstr "Захоплення не вдалося."

#. Translators: Message reported when a visual CAPTCHA is successfully solved.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1024
msgid "Visual CAPTCHA solved!"
msgstr "КАПЧУ розгадано!"

#. Translators: Message reported by NVDA when the AI cannot detect any CAPTCHA in the captured image.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1048
msgid "No CAPTCHA detected."
msgstr "CAPTCHA не виявлено."

#. Translators: Message reported when a visual CAPTCHA (like reCAPTCHA) is detected.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1056
msgid ""
"Visual CAPTCHA detected. Entering solving mode... This may take a little "
"while."
msgstr ""
"Виявлено візуальну КАПЧУ. Перехід у режим розв’язання... Це може зайняти "
"деякий час."

#. Translators: Message reported when a visual CAPTCHA is detected but the solver is disabled.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1065
msgid "Visual CAPTCHA detected, but the solver is disabled in settings."
msgstr "Виявлено візуальну КАПЧУ, але розв'язувач вимкнено в налаштуваннях."

#. Translators: Message reported when image capture fails or AI returns empty.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1071
msgid "Capture failed or AI returned empty response."
msgstr "Захоплення не вдалося, або ШІ повернув порожню відповідь."

#. Translators: Message reported by NVDA after successfully solving a text CAPTCHA, announcing the characters found.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1093
#, python-brace-format
msgid "Captcha: {text}"
msgstr "Captcha: {text}"

#. Translators: Message reported when AI fails to solve the visual CAPTCHA after max attempts.
#: addon\globalPlugins\visionAssistant\features\operator_captcha.py:1214
msgid "Failed to solve CAPTCHA after maximum attempts."
msgstr "Не вдалося розгадати КАПЧУ після максимальної кількості спроб."

#. Translators: Value representing the ON state for a toggle setting (e.g., in quick settings).
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:120
msgid "On"
msgstr "Увімкнено"

#. Translators: Value representing the OFF state for a toggle setting (e.g., in quick settings).
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:122
msgid "Off"
msgstr "Вимкнено"

#. Translators: Value announced in quick settings when the setting has no value selected yet.
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:135
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:145
msgid "Default"
msgstr "Початково"

#. Translators: Announced when navigating to AI Model quick settings
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:150
#, python-brace-format
msgid "{setting}, Current: {val}. Use left and right arrows to change."
msgstr ""
"{setting}, Поточне значення: {val}. Використовуйте стрілки вліво та вправо "
"для зміни."

#. Translators: Warning when models list is not fetched
#: addon\globalPlugins\visionAssistant\features\quick_settings.py:240
#, python-brace-format
msgid ""
"No models fetched for {provider}. Please update models list from settings."
msgstr ""
"Не знайдено моделей для {provider}. Будь ласка, оновіть список моделей у "
"налаштуваннях."

#. Translators: Message of a dialog which may pop up while performing an AI call
#: addon\globalPlugins\visionAssistant\features\upload.py:86
#, python-brace-format
msgid "File Upload Error: {error}"
msgstr "Помилка відвантаження файлу: {error}"

#. Translators: Prompt asking the user to manually input YouTube video duration.
#: addon\globalPlugins\visionAssistant\features\video.py:129
msgid ""
"Please enter the YouTube video duration in minutes (e.g., 10 or 10.5).\n"
"If you enter an incorrect duration, the audio description may not be complete."
msgstr ""
"Вкажіть тривалість відео на YouTube у хвилинах (наприклад, 10 або 10,5).\n"
"Якщо ви вкажете неправильну тривалість, аудіоопис може виявитися неповним."

#. Translators: Title for the YouTube duration input dialog.
#: addon\globalPlugins\visionAssistant\features\video.py:132
msgid "YouTube Video Duration"
msgstr "Тривалість відео на YouTube"

#. Translators: Error message shown when the entered YouTube duration is invalid.
#: addon\globalPlugins\visionAssistant\features\video.py:155
msgid "Invalid duration entered. Video analysis cancelled."
msgstr "Введено неправильну тривалість. Аналіз відео скасовано."

#. Translators: Title of the video action selection dialog.
#: addon\globalPlugins\visionAssistant\features\video.py:172
msgid "Video Action"
msgstr "Дія з відео"

#. Translators: Error message when video analysis is attempted with a non-Gemini provider.
#: addon\globalPlugins\visionAssistant\features\video.py:281
msgid "Video analysis is only supported by Gemini providers."
msgstr "Аналіз відео підтримується лише постачальниками Gemini."

#. Translators: Error message when the provided video URL is not valid.
#: addon\globalPlugins\visionAssistant\features\video.py:526
msgid "Error: Invalid URL."
msgstr "Помилка: неправильна адреса."

#. Translators: Error message when the video URL is from an unsupported website.
#: addon\globalPlugins\visionAssistant\features\video.py:539
msgid ""
"Error: Unsupported platform. Only YouTube, Instagram, Twitter, and TikTok are "
"supported."
msgstr ""
"Помилка: платформа не підтримується. Підтримуються лише YouTube, Instagram, "
"Twitter і TikTok."

#. Translators: Disclaimer added at the beginning of AI-generated SRT files.
#: addon\globalPlugins\visionAssistant\features\video.py:620
msgid ""
"Disclaimer: This audio description was generated by AI. Some details, "
"including character identities or events, may not be entirely accurate."
msgstr ""
"Застереження: Цей аудіоопис створено ШІ. Деякі деталі, зокрема особистості "
"персонажів чи події, можуть бути не зовсім точними."

#. Translators: Status message when uploading the video to the AI service fails. {error} holds the service-provided message.
#: addon\globalPlugins\visionAssistant\features\video.py:775
#, python-brace-format
msgid "Video upload failed: {error}"
msgstr "Не вдалося завантажити відео: {error}"

#. Translators: Status message when the AI is analyzing the whole video to extract character names and appearances.
#: addon\globalPlugins\visionAssistant\features\video.py:802
msgid "Extracting characters (First pass)..."
msgstr "Видобування персонажів (перший етап)..."

#. Translators: Error message shown when the AI fails to extract character information from the video.
#: addon\globalPlugins\visionAssistant\features\video.py:853
#: addon\globalPlugins\visionAssistant\features\video.py:932
msgid "Character extraction failed."
msgstr "Не вдалося видобути персонажа."

#. Translators: Status message when re-uploading the video after clearing its cache fails. {error} holds the service-provided message.
#: addon\globalPlugins\visionAssistant\features\video.py:901
#, python-brace-format
msgid "Video upload failed after cache retry: {error}"
msgstr "Не вдалося завантажити відео після повторної спроби кешу: {error}"

#. Translators: Header for the list of extracted characters in the generated subtitle.
#: addon\globalPlugins\visionAssistant\features\video.py:1024
msgid "GLOBAL CHARACTER DICTIONARY:"
msgstr "ГЛОБАЛЬНИЙ СЛОВНИК ПЕРСОНАЖІВ:"

#. Translators: Status message shown when the add-on pauses briefly between API requests to prevent hitting server rate limits. {seconds} is the number of seconds.
#: addon\globalPlugins\visionAssistant\features\video.py:1047
#, python-brace-format
msgid "Cooling down to prevent rate limits ({seconds} seconds)..."
msgstr "Пауза для запобігання обмеженню частоти запитів ({seconds} сек)..."

#. Translators: Header for the list of characters introduced up to the current video scene.
#: addon\globalPlugins\visionAssistant\features\video.py:1103
msgid "GLOBAL CHARACTER DICTIONARY (Active characters in this scene):"
msgstr "ГЛОБАЛЬНИЙ СЛОВНИК ПЕРСОНАЖІВ (Активні персонажі в цій сцені):"

#. Translators: Status message reporting which segment of the video is currently being analyzed. {current} is the current segment number and {total} is the total segment count.
#: addon\globalPlugins\visionAssistant\features\video.py:1133
#, python-brace-format
msgid "Analyzing video segment {current} of {total}..."
msgstr "Аналіз відеосегмента {current} з {total}..."

#. Translators: Message reported when AI is analyzing the video
#: addon\globalPlugins\visionAssistant\features\video.py:1138
#: addon\globalPlugins\visionAssistant\features\video.py:1495
msgid "Analyzing video..."
msgstr "Аналіз відео..."

#. Translators: Error message reported when video segment analysis fails after multiple retries due to network issues.
#: addon\globalPlugins\visionAssistant\features\video.py:1168
#: addon\globalPlugins\visionAssistant\features\video.py:1281
msgid "Connection failed after retries."
msgstr "З'єднання не вдалося встановити навіть після кількох спроб."

#. Translators: Status message shown when a video segment finishes processing and the system is moving to the next one. {current} is the completed segment number.
#: addon\globalPlugins\visionAssistant\features\video.py:1237
#, python-brace-format
msgid "Segment {current} finished. Preparing next..."
msgstr "Сегмент {current} завершено. Підготовка наступного..."

#. Translators: Status message when all segments are done and it is finalizing.
#: addon\globalPlugins\visionAssistant\features\video.py:1240
msgid "Finalizing..."
msgstr "Завершення..."

#. Translators: Error message shown when the AI output cannot be converted into a valid SRT subtitle file.
#: addon\globalPlugins\visionAssistant\features\video.py:1265
msgid "Failed to parse AI output into SRT."
msgstr "Не вдалося перетворити вихідні дані ШІ у формат SRT."

#. Translators: Error message when video recording is attempted with a non-Gemini provider
#: addon\globalPlugins\visionAssistant\features\video.py:1316
msgid "Video recording is only supported by Gemini providers."
msgstr "Запис відео підтримується лише провайдерами Gemini."

#. Translators: Status message reported when starting video recording
#: addon\globalPlugins\visionAssistant\features\video.py:1331
msgid "Starting recording..."
msgstr "Початок запису..."

#. Translators: Message when window capture fails and switches to full screen capture
#: addon\globalPlugins\visionAssistant\features\video.py:1403
msgid "Window capture failed. Trying full screen..."
msgstr "Не вдалося захопити вікно. Спроба розгорнути на весь екран..."

#. Translators: Error message when ffmpeg fails completely
#: addon\globalPlugins\visionAssistant\features\video.py:1409
msgid "Recording failed to start. FFmpeg encountered a fatal error."
msgstr "Не вдалося розпочати запис. У FFmpeg сталася фатальна помилка."

#. Translators: Message when video recording starts
#: addon\globalPlugins\visionAssistant\features\video.py:1419
msgid "Recording started. Press the same shortcut again to stop."
msgstr ""
"Запис розпочато. Щоб зупинити запис, натисніть цю комбінацію клавіш ще раз."

#. Translators: Error message when recording fails to start
#: addon\globalPlugins\visionAssistant\features\video.py:1433
#, python-brace-format
msgid "Failed to start recording: {error}"
msgstr "Не вдалося розпочати запис: {error}"

#. Translators: Error when recorded video file is not found
#: addon\globalPlugins\visionAssistant\features\video.py:1453
msgid "Recording file not found."
msgstr "Файл запису не знайдено."

#. Translators: Error when recorded video file is too small/corrupted
#: addon\globalPlugins\visionAssistant\features\video.py:1464
msgid ""
"The recording was too short or the video file is corrupted. Please try "
"recording for at least a few seconds."
msgstr ""
"Запис був занадто коротким або відеофайл пошкоджений. Будь ласка, спробуйте "
"записати хоча б кілька секунд."

#. Translators: Status message showing recording info, {duration} is seconds, {size} is MB
#: addon\globalPlugins\visionAssistant\features\video.py:1470
#, python-brace-format
msgid "Recording stopped ({duration:.0f} seconds, {size:.1f} MB)"
msgstr "Запис зупинено ({duration:.0f} секунд, {size:.1f} МБ)"

#. Translators: Error message when processing recorded video fails
#: addon\globalPlugins\visionAssistant\features\video.py:1525
#, python-brace-format
msgid "Failed to process recording: {error}"
msgstr "Не вдалося обробити запис: {error}"

#. Translators: Message reported when calling translation command
#: addon\globalPlugins\visionAssistant\features\vision.py:80
#, python-brace-format
msgid "Translated: {text}"
msgstr "Перекладено: {text}"

#. Translators: Option in image file action menu to perform OCR
#: addon\globalPlugins\visionAssistant\features\vision.py:88
msgid "Extract Text (OCR)"
msgstr "Видобути текст (OCR)"

#. Translators: Option in image file action menu to generate a visual description
#: addon\globalPlugins\visionAssistant\features\vision.py:90
msgid "Describe Image"
msgstr "Описати зображення"

#. Translators: Title of the image file action selection dialog
#: addon\globalPlugins\visionAssistant\features\vision.py:97
msgid "Image File"
msgstr "Файл зображення"

#. Translators: Status reported when an image file is being analyzed
#: addon\globalPlugins\visionAssistant\features\vision.py:115
msgid "Analyzing Image File..."
msgstr "Аналіз файлу зображення..."

#. Translators: Title of the dialog asking whether to resume an OCR operation that did not finish (for example after NVDA closed unexpectedly).
#: addon\globalPlugins\visionAssistant\features\vision.py:148
msgid "Unfinished Operation"
msgstr "Незавершена операція"

#. Translators: Message asking whether to continue an interrupted OCR extraction. {done} is the number of pages already processed, {total} is the total number of pages, and {files} is the number of files involved.
#: addon\globalPlugins\visionAssistant\features\vision.py:151
#, python-brace-format
msgid ""
"You have an unfinished operation: {done} of {total} pages processed across "
"{files} file(s). Would you like to continue from where it stopped?"
msgstr ""
"У вас є незавершена операція: оброблено {done} з {total} сторінок у файлах "
"{files}. Бажаєте продовжити з того місця, де вона була зупинена?"

#. Translators: Initial greeting message for the Direct Chat dialog.
#: addon\globalPlugins\visionAssistant\features\vision.py:312
msgid "Hello! I am Vision Assistant Pro. How can I help you today?"
msgstr "Вітаю! Я — Vision Assistant Pro. Чим я можу вам допомогти сьогодні?"

#. Translators: Dialog title for Direct Chat
#: addon\globalPlugins\visionAssistant\features\vision.py:317
#, python-brace-format
msgid "{name} - Direct Chat"
msgstr "{name} - Прямий чат"

#. Translators: Dialog title for a Chat dialog
#: addon\globalPlugins\visionAssistant\features\vision.py:416
#, python-brace-format
msgid "{name} - Chat"
msgstr "{name} - Чат"

#. Translators: File dialog filter for supported files
#: addon\globalPlugins\visionAssistant\features\vision.py:434
msgid "Supported Files"
msgstr "Підтримувані файли"

#. Translators: Title of Refine Result dialog
#: addon\globalPlugins\visionAssistant\features\vision.py:697
#, python-brace-format
msgid "{name} - Refine Result"
msgstr "{name} - Уточнити результат"

#. Translators: Dialog title for Translation results
#: addon\globalPlugins\visionAssistant\features\vision.py:743
#, python-brace-format
msgid "{name} - Translation"
msgstr "{name} - Переклад"

#. Translators: Dialog title for Image Analysis
#: addon\globalPlugins\visionAssistant\features\vision.py:848
#, python-brace-format
msgid "{name} - Image Analysis"
msgstr "{name} – Аналіз зображень"

#. Translators: Title of the error dialog shown when the selected OCR engine cannot process the chosen image-based files.
#: addon\globalPlugins\visionAssistant\features\vision.py:877
#: addon\globalPlugins\visionAssistant\features\vision.py:1261
msgid "OCR Engine Error"
msgstr "Помилка механізму OCR"

#. Translators: Error when PyMuPDF is missing
#: addon\globalPlugins\visionAssistant\features\vision.py:887
#: addon\globalPlugins\visionAssistant\features\vision.py:1248
msgid "PyMuPDF library is missing."
msgstr "Бібліотека PyMuPDF відсутня."

#. Translators: Error when no pages found
#: addon\globalPlugins\visionAssistant\features\vision.py:893
#: addon\globalPlugins\visionAssistant\features\vision.py:1268
msgid "No readable pages found."
msgstr "Читабельних сторінок не знайдено."

#. Translators: Error message shown when the OCR process fails to detect any text in the file or an unknown error occurs during extraction.
#: addon\globalPlugins\visionAssistant\features\vision.py:1101
msgid "No text detected or error occurred."
msgstr "Текст не виявлено або сталася помилка."

#. Translators: Error message shown when uploading a document batch fails after multiple attempts. {start} and {end} are page numbers.
#: addon\globalPlugins\visionAssistant\features\vision.py:1201
#, python-brace-format
msgid "Failed to process document batch {start}-{end} after multiple attempts."
msgstr "Не вдалося обробити пакет документів {start}-{end} після кількох спроб."

#. Translators: Error message shown when the connection to the server times out
#: addon\globalPlugins\visionAssistant\features\vision.py:1225
msgid "Connection Timeout"
msgstr "Час очікування підключення"

#. Translators: Error message shown when document batch processing fails. {start} and {end} are page numbers, {error} is the error details.
#: addon\globalPlugins\visionAssistant\features\vision.py:1228
#, python-brace-format
msgid "Failed to process document batch {start}-{end}: {error}"
msgstr "Не вдалося обробити пакет документів {start}-{end}: {error}"

#. Translators: Message reported when calling an image analysis command
#: addon\globalPlugins\visionAssistant\features\vision.py:1462
msgid "Scanning..."
msgstr "Сканування..."

#. Translators: Announcement when an in-progress OCR extraction is stopped by the user.
#: addon\globalPlugins\visionAssistant\features\vision.py:1480
msgid "OCR operation stopped."
msgstr "Операцію OCR зупинено."

#. Translators: Message reported when executing the refine command
#: addon\globalPlugins\visionAssistant\features\vision.py:1656
msgid "Uploading file..."
