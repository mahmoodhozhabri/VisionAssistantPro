#. Translators: Option to use the global feedback setting for a custom prompt.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:229
msgid "Use global setting (default)"
msgstr "استفاده از تنظیمِ سراسری (پیش‌فرض)"

#. Translators: Option to copy prompt result to clipboard.
#. Translators: Checkbox to enable copying AI responses to clipboard
#: addon\globalPlugins\visionAssistant\prompt_utils.py:231
#: addon\globalPlugins\visionAssistant\dialogs\settings.py:378
msgid "Copy AI responses to clipboard"
msgstr "کپی کردنِ پاسخ‌های هوشِ مصنوعی در کلیپ‌بورد"

#. Translators: Option to output prompt result directly without opening a chat window.
#. Translators: Checkbox to skip chat window and only speak AI responses
#: addon\globalPlugins\visionAssistant\prompt_utils.py:233
#: addon\globalPlugins\visionAssistant\dialogs\settings.py:388
msgid "Direct Output (No Chat Window)"
msgstr "خروجیِ مستقیم (بدونِ پنجره‌ی گفتگو)"

#. Translators: Option to copy prompt result to clipboard and output directly without a chat window.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:235
msgid "Copy AI responses to clipboard and Direct Output"
msgstr "کپیِ پاسخ‌های هوشِ مصنوعی در کلیپ‌بورد و خروجیِ مستقیم"

#. Translators: Option to display prompt results in a chat window with follow-up questions.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:237
msgid "Chat Window (Ask questions)"
msgstr "پنجره‌ی گفتگو (طرحِ پرسش)"

#. Translators: Validation error for empty prompt text.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:460
#: addon\globalPlugins\visionAssistant\prompt_utils.py:464
#: addon\globalPlugins\visionAssistant\dialogs\prompt_manager_dialog.py:149
#: addon\globalPlugins\visionAssistant\dialogs\prompt_manager_dialog.py:598
msgid "Prompt text cannot be empty."
msgstr "متنِ پرامپت نمی‌تواند خالی باشد."

#. Translators: Validation error when multiple ambient observer modes are used in a single prompt.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:470
#, python-brace-format
msgid "Cannot combine multiple ambient observer modes ({modes}) in the same prompt."
msgstr "امکانِ ترکیبِ چند حالتِ مشاهده‌گرِ محیطی ({modes}) در یک پرامپت وجود ندارد."

#. Translators: Validation error when static capture variables are combined with an ambient observer mode.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:479
#, python-brace-format
msgid "Cannot combine static capture variables ({vars}) with ambient observer ({mode})."
msgstr "امکانِ ترکیبِ متغیرهای ثبتِ ایستا ({vars}) با مشاهده‌گرِ محیطی ({mode}) وجود ندارد."

#. Translators: Validation error when both loopback and mic audio sources are specified.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:486
msgid "Cannot combine both [loopback] and [mic] audio sources."
msgstr "امکانِ ترکیبِ همزمانِ منابعِ صوتیِ [loopback] و [mic] وجود ندارد."

#. Translators: Validation error when [loopback] is used without [ambient_audio].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:490
msgid "[loopback] can only be used with [ambient_audio]."
msgstr "[loopback] فقط همراه با [ambient_audio] قابل استفاده است."

#. Translators: Validation error when [mic] is used without [ambient_audio] or [ambient_webcam].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:494
msgid "[mic] can only be used with [ambient_audio] or [ambient_webcam]."
msgstr "[mic] فقط همراه با [ambient_audio] یا [ambient_webcam] قابل استفاده است."

#. Translators: Validation error when both brief and detailed reporting styles are specified.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:500
msgid "Cannot combine both [brief] and [detailed] reporting styles."
msgstr "امکانِ ترکیبِ همزمانِ سبک‌های گزارش‌دهیِ [brief] و [detailed] وجود ندارد."

#. Translators: Validation error when reporting styles are used with [ambient_audio].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:505
msgid "Reporting styles ([brief], [detailed]) cannot be used with [ambient_audio]."
msgstr "سبک‌های گزارش‌دهی ([brief], [detailed]) همراه با [ambient_audio] قابل استفاده نیستند."

#. Translators: Validation error when reporting styles are used without an ambient visual observer.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:509
msgid "Reporting styles ([brief], [detailed]) can only be used with [ambient_screen] or [ambient_webcam]."
msgstr "سبک‌های گزارش‌دهی ([brief], [detailed]) فقط همراه با [ambient_screen] یا [ambient_webcam] قابل استفاده هستند."

#. Translators: Validation error when a [lang:code] tag is malformed.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:517
#, python-brace-format
msgid "Invalid language tag '{tag}'. Use [lang:code], for example [lang:fa] or [lang:en]."
msgstr "برچسبِ زبانِ نامعتبر '{tag}'. از [lang:code] استفاده کنید، برای نمونه [lang:fa] یا [lang:en]."

#. Translators: Validation error when multiple [lang:code] tags are present in the same prompt.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:522
msgid "Only one [lang:code] tag can be used in a prompt."
msgstr "در هر پرامپت فقط یک برچسبِ [lang:code] قابل استفاده است."

#. Translators: Validation error when [lang:code] is used without an ambient mode.
#: addon\globalPlugins\visionAssistant\prompt_utils.py:526
msgid "[lang:code] can only be used with ambient observer modes."
msgstr "[lang:code] فقط همراه با حالاتِ مشاهده‌گرِ محیطی قابل استفاده است."

#. Translators: Validation error when non-variable text instructions are included in [ambient_audio].
#: addon\globalPlugins\visionAssistant\prompt_utils.py:536
msgid "Audio Observer does not accept instructional text prompts. Only audio source and [lang:code] are supported."
msgstr "مشاهده‌گرِ صوتی پرامپت‌های متنیِ دستوری را نمی‌پذیرد. فقط منبعِ صوتی و [lang:code] پشتیبانی می‌شوند."

